APP_NAME=WebsiteComparison
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=website_comparison
DB_USERNAME=app
DB_PASSWORD=change-me

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=website_comparison_cache

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# 実際にResend経由での送信を確認したい場合のみ、MAIL_MAILER=resendに変更し
# RESEND_API_KEYを設定する(未設定時はmailpitへ送られ、http://localhost:8025 の
# mailpit UIで確認できる)。送信ドメインのSPF/DKIM認証はResendダッシュボード
# 側の作業でコードでは解決できないため、未認証のドメインで送るとAPIは成功
# するのに受信箱に届かない。
RESEND_API_KEY=

# 診断開始通知/相談リクエスト通知の宛先(共有の受信箱を指定すること)。
LEAD_NOTIFICATION_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

FRONTEND_URL=http://localhost:3000
# CORS_ALLOWED_ORIGINSは、FRONTEND_URL以外にも追加でCORSを許可したいOriginが
# ある場合のみカンマ区切りで設定する(例: ステージング用フロントエンドを併用する場合)。
# 通常は空のままでよい。"*"を指定しても無視される(supports_credentials=trueと
# "*"は仕様上併用できないため)。
CORS_ALLOWED_ORIGINS=
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost

ANALYZER_URL=http://analyzer:3001
ANALYZER_TOKEN=change-me-analyzer-token
ANALYSIS_STORAGE_PATH=/var/analysis-storage
# 2026-08-25: 依頼では「ダブルクォートを外せば直る」という前提だったが、
# 実際にvlucas/phpdotenv(Laravelが使うDotenvパーサ)で検証したところ、
# 引用符を外すとスペースを含む値そのものがパースエラーになった
# ("Encountered unexpected whitespace")。このためダブルクォートは
# 外せない(必須構文)。
#
# 本番で観測された引用符混入は、.envファイルの構文(この行全体)を
# そのままRenderの環境変数の「値」欄に貼り付けたことが原因と判断する ――
# Renderの環境変数欄はDotenv構文を解釈しない単なる文字列フィールドのため、
# ダブルクォートを含めて貼るとその文字自体が値に混入する。Render側で
# 設定する際は、この行の"KEY=…"部分を含めず、ダブルクォートの中身
# (WebsiteComparisonBot/0.2 (+https://...)の部分)だけを値として入力する
# こと。<公開ドメイン>と<問い合わせ先>は値が未確定のためプレースホルダの
# まま残している ―― 実際のドメイン・問い合わせ先メールアドレスが確定次第、
# こことRenderの環境変数の両方を更新すること。
CRAWLER_USER_AGENT="WebsiteComparisonBot/0.2 (+https://<公開ドメイン>/bot; contact: <問い合わせ先>)"

# --------------------------------------------------------------------------
# 外部Provider設定
# --------------------------------------------------------------------------
# 通常利用(production含む)を想定したデフォルト。SEMRUSH_API_KEY/OPENAI_API_KEYを
# 設定しない限り、それぞれSEO/AI関連の指標はunavailable、またはAPIキー未設定の
# 明確な設定エラーになります(モックへ自動的にフォールバックすることはありません)。
SEO_PROVIDER=semrush
SEMRUSH_API_KEY=
SEMRUSH_DATABASE=jp
SEMRUSH_TIMEOUT=30
SEMRUSH_MAX_RETRIES=1
SEMRUSH_DAILY_UNIT_LIMIT=
SEMRUSH_CACHE_TTL_HOURS=24

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT=60
AI_MAX_RETRIES=1
# 未設定(空)の場合、config('services.ai.max_input_tokens')は6000にフォール
# バックする(2026-08-03、「無制限」を既定にしない ―― 本文の多いサイト1件で
# 想定外のコスト・コンテキスト超過が起きるのを防ぐ)。超過分は既存の
# 切り詰め処理(採用ページ本文を優先して残す)が働く。
AI_MAX_INPUT_TOKENS=
AI_MAX_OUTPUT_TOKENS=2000

# ブランド・ホイール分析のモデル。本番は gpt-4o。
# gpt-4o-mini に下げると、プロンプト中の定義文をそのまま
# evidence として返す挙動が高頻度で発生し、同一入力でも
# 判定結果が実行ごとに変わる(2026-08 実測: 同一サイト同一入力で
# matched が 3/0/3 と変動。gpt-4o では 8/8/8 で完全安定)。
# コスト削減目的で変更しないこと。
# 未設定時はOPENAI_MODELにフォールバックするため、この行が無いと
# 上のOPENAI_MODELが使われ、実データ検証が本番と違うモデルを
# 測ることになる(2026-08-24に一度これで気づかず本番と異なる
# モデルで検証してしまった)。
BRAND_WHEEL_AI_MODEL=gpt-4o

# 2026-08-25追加: リード向けレポートを生成する下限のmatched件数(24項目中)。
# BrandWheelReportEligibility::isReportable()が使う。この値未満は
# レポートを生成せず、リード診断回数も消費しない(2026-08-24発行の
# レポート33、自社1/24が顧客提出可能な品質を満たさなかったための引き上げ)。
# Renderの環境変数だけで再デプロイなしに調整できる。
BRAND_WHEEL_REPORT_MIN_MATCHED=6

# ALLOW_MOCK_PROVIDERSは、SEO_PROVIDER=mock / AI_PROVIDER=mockを許可するための
# 明示的なスイッチです(通常起動時に意図せずデモデータが使われるのを防ぐため)。
# production環境ではAPP_ENV判定により、この値に関わらずMock Providerは
# 常に拒否されます。ローカル開発でAPIキーを用意せずデモデータのまま試したい
# 場合のみ、下の3行のコメントを外してtrueにし、SEO_PROVIDER/AI_PROVIDERを
# mockに変更してください。
ALLOW_MOCK_PROVIDERS=false
# ALLOW_MOCK_PROVIDERS=true
# SEO_PROVIDER=mock
# AI_PROVIDER=mock

# --------------------------------------------------------------------------
# リード向けセルフ診断機能
# --------------------------------------------------------------------------
# 社内向けフル機能(ANALYSIS_MAX_WEBSITES_PER_ANALYSIS等)とは独立した設定。
# LEAD_MAX_CONCURRENT_ANALYSESやAnalyzerの同時実行数(ANALYZER_MAX_CONCURRENCY)を
# 安易に引き上げないこと(OOM再発のリスクがあります)。
LEAD_MAX_WEBSITES=2
LEAD_TOKEN_EXPIRY_DAYS=7
LEAD_MAX_ANALYSES_PER_TOKEN=1
# 2026-08-24追加: 成否を問わない試行回数の上限(白紙レポート防止に伴う
# 無制限リトライ対策)。LEAD_MAX_ANALYSES_PER_TOKENとは別の歯止め。
LEAD_MAX_ATTEMPTS_PER_TOKEN=5
LEAD_MAX_CONCURRENT_ANALYSES=1
# 2026-08-18: 本番実測でLighthouseが1診断の所要時間の大半(平均108秒中約106秒)
# を占めることが判明したため、リード分析では省略する(既定true)。
LEAD_SKIP_LIGHTHOUSE=true
# スクリーンショット由来の指標は0件のため、リード分析では撮影自体を省略する。
LEAD_SKIP_SCREENSHOTS=true
LEAD_RETENTION_DAYS_AFTER_EXPIRY=180

# --------------------------------------------------------------------------
# 管理者ダッシュボード(/admin)
# --------------------------------------------------------------------------
# DBにユーザーを作らない共有アカウント方式。ADMIN_PASSWORD_HASHは平文では
# なくHash::make()の出力(bcrypt)を設定すること。生成例:
#   php artisan tinker --execute="echo Hash::make('設定したいパスワード');"
# 実際の値はコミットしない(このファイルには変数名のみ)。
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
