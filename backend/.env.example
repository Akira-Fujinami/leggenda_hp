APP_NAME=WebsiteComparison
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=website_comparison
DB_USERNAME=app
DB_PASSWORD=change-me

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=website_comparison_cache

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# 実際にResend経由での送信を確認したい場合のみ、MAIL_MAILER=resendに変更し
# RESEND_API_KEYを設定する(未設定時はmailpitへ送られ、http://localhost:8025 の
# mailpit UIで確認できる)。送信ドメインのSPF/DKIM認証はResendダッシュボード
# 側の作業でコードでは解決できないため、未認証のドメインで送るとAPIは成功
# するのに受信箱に届かない。
RESEND_API_KEY=

# 診断開始通知/相談リクエスト通知の宛先(共有の受信箱を指定すること)。
LEAD_NOTIFICATION_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

FRONTEND_URL=http://localhost:3000
# CORS_ALLOWED_ORIGINSは、FRONTEND_URL以外にも追加でCORSを許可したいOriginが
# ある場合のみカンマ区切りで設定する(例: ステージング用フロントエンドを併用する場合)。
# 通常は空のままでよい。"*"を指定しても無視される(supports_credentials=trueと
# "*"は仕様上併用できないため)。
CORS_ALLOWED_ORIGINS=
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost

ANALYZER_URL=http://analyzer:3001
ANALYZER_TOKEN=change-me-analyzer-token
ANALYSIS_STORAGE_PATH=/var/analysis-storage
CRAWLER_USER_AGENT="WebsiteComparisonBot/0.1 (+https://example.com/bot)"

# --------------------------------------------------------------------------
# 外部Provider設定
# --------------------------------------------------------------------------
# 通常利用(production含む)を想定したデフォルト。SEMRUSH_API_KEY/OPENAI_API_KEYを
# 設定しない限り、それぞれSEO/AI関連の指標はunavailable、またはAPIキー未設定の
# 明確な設定エラーになります(モックへ自動的にフォールバックすることはありません)。
SEO_PROVIDER=semrush
SEMRUSH_API_KEY=
SEMRUSH_DATABASE=jp
SEMRUSH_TIMEOUT=30
SEMRUSH_MAX_RETRIES=1
SEMRUSH_DAILY_UNIT_LIMIT=
SEMRUSH_CACHE_TTL_HOURS=24

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT=60
AI_MAX_RETRIES=1
# 未設定(空)の場合、config('services.ai.max_input_tokens')は6000にフォール
# バックする(2026-08-03、「無制限」を既定にしない ―― 本文の多いサイト1件で
# 想定外のコスト・コンテキスト超過が起きるのを防ぐ)。超過分は既存の
# 切り詰め処理(採用ページ本文を優先して残す)が働く。
AI_MAX_INPUT_TOKENS=
AI_MAX_OUTPUT_TOKENS=2000

# ALLOW_MOCK_PROVIDERSは、SEO_PROVIDER=mock / AI_PROVIDER=mockを許可するための
# 明示的なスイッチです(通常起動時に意図せずデモデータが使われるのを防ぐため)。
# production環境ではAPP_ENV判定により、この値に関わらずMock Providerは
# 常に拒否されます。ローカル開発でAPIキーを用意せずデモデータのまま試したい
# 場合のみ、下の3行のコメントを外してtrueにし、SEO_PROVIDER/AI_PROVIDERを
# mockに変更してください。
ALLOW_MOCK_PROVIDERS=false
# ALLOW_MOCK_PROVIDERS=true
# SEO_PROVIDER=mock
# AI_PROVIDER=mock

# --------------------------------------------------------------------------
# リード向けセルフ診断機能
# --------------------------------------------------------------------------
# 社内向けフル機能(ANALYSIS_MAX_WEBSITES_PER_ANALYSIS等)とは独立した設定。
# LEAD_MAX_CONCURRENT_ANALYSESやAnalyzerの同時実行数(ANALYZER_MAX_CONCURRENCY)を
# 安易に引き上げないこと(OOM再発のリスクがあります)。
LEAD_MAX_WEBSITES=2
LEAD_TOKEN_EXPIRY_DAYS=7
LEAD_MAX_ANALYSES_PER_TOKEN=1
LEAD_MAX_CONCURRENT_ANALYSES=1
# Phase 2でSemrush併用が承認されたため、Lighthouseは省略しない(既定false)。
LEAD_SKIP_LIGHTHOUSE=false
# スクリーンショット由来の指標は0件のため、リード分析では撮影自体を省略する。
LEAD_SKIP_SCREENSHOTS=true
LEAD_RETENTION_DAYS_AFTER_EXPIRY=180
