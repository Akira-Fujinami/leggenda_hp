# backend Web Service / normal・heavy・external worker 共通の本番envテンプレート。
# 値は例であり、Secretはここに書かない(Renderダッシュボードで直接設定すること)。
#
# 【本番構成】frontendはNext.jsの同一Origin BFFプロキシ(frontend/src/app/backend/
# [...path]/route.ts)経由でこのbackendへアクセスする。ブラウザは常に
# frontendと同じOriginにしかアクセスせず、frontend Route Handlerがサーバー側で
# backendへ転送するため、Cookie(XSRF-TOKEN・セッション)はfrontendのOriginの
# ファーストパーティCookieとして保存される。これによりSameSite=Noneは不要になり、
# カスタムドメイン/サブドメインも不要(*.onrender.com標準URLのままで良い)。

APP_NAME=WebsiteComparison
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Redisは使用しない(有料Key Value/Background Workerを前提にしない運用のため)。
# SESSION_DRIVER=databaseはRender Postgresへ保存する構成(推奨・既定)。
# sessionsテーブルはLaravel標準の 0001_01_01_000000_create_users_table.php
# マイグレーションで既に作成される(usersテーブルと同じマイグレーションに含まれる。
# 追加のmigrationは不要)。
#
# QUEUE_CONNECTION=databaseも同様にjobs/failed_jobsテーブル(Postgres)を使う。
# Backend Web Serviceのentrypoint(docker/scripts/backend-entrypoint.render.sh)が
# 起動時にqueue:workをコンテナ内で常駐・自動再起動させるため、別途Render
# Background Worker Serviceを用意する必要はない。
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# --------------------------------------------------------------------------
# Queue worker (Backend Web Service内に常駐させるqueue:workの設定)
# --------------------------------------------------------------------------
# database queueの「Workerが死んでいるとみなす」までの秒数。queue:workの
# --timeout(既定600秒)より十分大きくすること ―― 短いと、再デプロイ時に
# 旧Workerがまだ実行中のジョブを、起動直後の新Workerが二重に取得してしまう。
DB_QUEUE_RETRY_AFTER=700

# 以下はentrypoint側の既定値(analysis,external-api,analysis-heavy,ai /
# sleep=3 / tries=2 / timeout=600 / memory=256MB)を使うなら設定不要。
# 変更したい場合のみ明示的に上書きする。
# ENABLE_EMBEDDED_QUEUE_WORKER=true
# QUEUE_WORKER_QUEUES=analysis,external-api,analysis-heavy,ai
# QUEUE_WORKER_SLEEP=3
# QUEUE_WORKER_TRIES=2
# QUEUE_WORKER_TIMEOUT=600
# QUEUE_WORKER_MEMORY=256

# --------------------------------------------------------------------------
# CORS / Sanctum / Session Cookie
# --------------------------------------------------------------------------
# FRONTEND_URLはfrontend Web ServiceのRender公開URL(ブラウザが実際にアクセスするURL)。
# ブラウザは同一Origin経由でしかbackendへアクセスしないためCORSは実質使われないが、
# 直接backendを叩くクライアント向けの保険として引き続き設定しておく。
FRONTEND_URL=https://<frontend-service>.onrender.com
# CORS_ALLOWED_ORIGINSは、FRONTEND_URL以外にも追加で許可したいOriginが
# ある場合のみカンマ区切りで設定する。単一フロントエンドのみなら空のままでよい。
CORS_ALLOWED_ORIGINS=

# SanctumのEnsureFrontendRequestsAreStateful::fromFrontend()が、frontend Route Handler
# から転送されるOrigin/Refererヘッダー(値はFRONTEND_ORIGIN、frontend側のenv参照)を
# stateful(Cookieセッション認証対象)と認識するために必要。schemeを含めないこと。
SANCTUM_STATEFUL_DOMAINS=<frontend-service>.onrender.com

# 同一Originプロキシ構成のため、SameSite=Noneは不要。ブラウザはfrontendの
# Originにしかアクセスしないので、通常のfirst-party Cookieと同じSameSite=laxで良い。
# SESSION_DOMAINは環境変数として一切設定しない(空文字すら残さない)こと。
# 明示的に空文字を設定した場合とenv自体が存在しない場合とでLaravelの挙動に
# 差は無いが(env('SESSION_DOMAIN')はどちらもnullを返す)、意図を明確にするため
# このテンプレートにも敢えて書かない。
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# 単位は分。120分(2時間)操作が無ければ失効する。数分でログアウトする場合、
# ここではなくセッション自体が永続化されていない(SESSION_DRIVER設定/
# APP_KEYの不安定さ等)を疑うこと。
SESSION_LIFETIME=120
# 他環境・他アプリのセッションCookieと名前が衝突しないよう明示する
# (未設定時は "websitecomparison-session" のようにAPP_NAMEから自動生成される)。
SESSION_COOKIE=leggenda_hp_session

MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

ANALYZER_URL=
ANALYZER_TOKEN=
ANALYSIS_STORAGE_PATH=/var/analysis-storage

SEO_PROVIDER=semrush
ALLOW_MOCK_PROVIDERS=false
SEMRUSH_API_KEY=
SEMRUSH_DATABASE=jp

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# リード向けセルフ診断機能。未設定でも安全な既定値(左記コメント参照)で
# 動作するため必須ではない。LEAD_MAX_CONCURRENT_ANALYSESや
# ANALYZER_MAX_CONCURRENCYを安易に引き上げないこと(OOM再発のリスク)。
LEAD_MAX_WEBSITES=2
LEAD_TOKEN_EXPIRY_DAYS=7
LEAD_MAX_ANALYSES_PER_TOKEN=1
LEAD_MAX_CONCURRENT_ANALYSES=1
LEAD_SKIP_LIGHTHOUSE=true
LEAD_RETENTION_DAYS_AFTER_EXPIRY=180
