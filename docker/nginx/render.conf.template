server {
    listen ${PORT} default_server;
    server_name _;
    root /var/www/html/public;
    index index.php;

    # 依頼BI-4(2026-09-08): upload_max_filesize(20MB、php.ini参照)より
    # 確実に大きくする ―― 同値だとnginxがPHPより先に413を返し、原因が
    # 分かりにくくなる(本番はこちら)。
    #
    # 依頼BS-1(2026-09-11): post_max_size(25M、php.ini)と同値のままだと、
    # 今度はここ(いちばん外側の関門)が同じ構図の問題を起こしていた ――
    # 26MBのリクエストはnginxがPHPより先に413 Request Entity Too Largeで
    # 弾いてしまい、post_max_size超過(→CSRFトークン消失→419)経路が
    # 一度も発火しないため、依頼BR-1でbootstrap/app.phpに追加した
    # 419ハンドラ(日本語の案内)にも到達できなかった(依頼BRの実HTTP検証で
    # 発覚)。post_max_size/upload_max_filesize/アプリ上限を上げたのと
    # 同じ理由で、外側の関門を内側より確実に大きくする ―― 30MBに引き上げ、
    # post_max_size(25M)との間に5MBの余裕を残す。
    #
    # 上限の階層(この順序を崩さないこと):
    #   client_max_body_size(30M, nginx) > post_max_size(25M, PHP)
    #     > upload_max_filesize(22M, PHP) > アプリ上限(20MB, config)
    #
    # 30MBを超えるリクエストは、依然としてnginxの素の413(英語)のまま
    # ―― アプリより手前の関門をすべて日本語化するには、nginx自体の
    # カスタムエラーページが別途必要になる(依頼BS-1で対象外と明記)。
    client_max_body_size 30M;

    # Renderのログ収集はコンテナのstdout/stderrを読むため、
    # nginxのアクセス/エラーログもファイルではなくそこへ出す。
    access_log /dev/stdout;
    error_log /dev/stderr warn;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # nginxは正規表現locationを記述順で最初に一致したものを採用するため、
    # 拒否ルールは "\.php$" より必ず前に置く (でないと /vendor/foo.php 等が
    # 先にPHPへfastcgi_passされてしまい、拒否ルールへ到達しない)。

    # 隠しファイル (.env含む) は拒否。.well-known だけは許可 (ACME等で使用)。
    location ~ /\.(?!well-known) {
        deny all;
    }

    # public/ 配下に紛れ込んだ場合の保険として、Laravel内部ディレクトリ・
    # Composerメタファイルへの直接アクセスを明示的に拒否する。
    location ~* ^/(vendor|storage|composer\.(json|lock|phar))(/|$) {
        deny all;
    }

    location ~ \.php$ {
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_read_timeout 300;
    }
}
